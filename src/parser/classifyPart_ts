export function classifyPart(headerPart: string, cardName: string, symbol: string): string {
  if (headerPart && headerPart !== "미분류") return headerPart;

  const text = `${cardName} ${symbol}`;

  if (/독립기초|줄기초|MF|기초/.test(text)) return "기초";
  if (/기본형|SRC|기둥/.test(text)) return "기둥";
  if (/전단형|내\.중\.외단형|양단중앙형|인방보|LB|B\d|G\d/.test(text)) return "보";
  if (/슬라브|복배근|평DECK|DS|CS|S\d/.test(text)) return "슬라브";
  if (/옹벽|CUT보강|PARAPET|RW|CW|W\d/.test(text)) return "옹벽";
  if (/계단|분할ST|SS/.test(text)) return "계단";

  return "미분류";
}
