import type { CardBox } from "../types/rebar";

export function detectCards(pageWidth: number, pageHeight: number): CardBox[] {
  const marginX = pageWidth * 0.04;
  const marginTop = pageHeight * 0.15;
  const gapX = pageWidth * 0.02;
  const gapY = pageHeight * 0.08;

  const cardWidth = (pageWidth - marginX * 2 - gapX * 2) / 3;
  const cardHeight = (pageHeight - marginTop - pageHeight * 0.08 - gapY) / 2;

  const boxes: CardBox[] = [];

  for (let row = 0; row < 2; row++) {
    for (let col = 0; col < 3; col++) {
      boxes.push({
        cardIndex: row * 3 + col + 1,
        x: marginX + col * (cardWidth + gapX),
        y: marginTop + row * (cardHeight + gapY),
        width: cardWidth,
        height: cardHeight
      });
    }
  }

  return boxes;
}
