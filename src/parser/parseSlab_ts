import type { SlabData } from "../types/rebar";

export function parseSlab(ocrText: string): SlabData {
  const isDeck = /DECK|평DECK/.test(ocrText);
  const thickness = ocrText.match(/두께\s*\[?(\d+(?:\.\d+)?)\]?/)?.[1] ?? "";

  const bars = [...ocrText.matchAll(/H\d+\s*@\s*\d+/g)].map((m) =>
    m[0].replace(/\s+/g, "")
  );

  return {
    thickness,
    isDeck,
    topMainBar: bars[0] ?? "",
    topSubBar: bars[1] ?? "",
    bottomMainBar: bars[2] ?? "",
    bottomSubBar: bars[3] ?? ""
  };
}
