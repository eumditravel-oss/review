import type { StairData } from "../types/rebar";

export function parseStair(ocrText: string): StairData {
  const thickness = ocrText.match(/\[(\d+(?:\.\d+)?)\]/)?.[1] ?? "";
  const reinforcement = [...ocrText.matchAll(/H\d+\s*-\s*\d+\s*EA/g)].map((m) =>
    m[0].replace(/\s+/g, "")
  );

  return {
    thickness,
    rows: [
      {
        area: "참부",
        barType: "주근",
        position: "",
        rebar: ""
      },
      {
        area: "참부",
        barType: "부근",
        position: "",
        rebar: ""
      },
      {
        area: "계단부",
        barType: "주근",
        position: "",
        rebar: ""
      },
      {
        area: "계단부",
        barType: "부근",
        position: "",
        rebar: ""
      },
      {
        area: "보강근",
        barType: "보강근",
        position: "",
        rebar: reinforcement.join(", ")
      }
    ]
  };
}
