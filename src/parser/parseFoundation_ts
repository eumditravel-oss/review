import type { FoundationData } from "../types/rebar";

export function parseFoundation(ocrText: string): FoundationData {
  const thickness = ocrText.match(/\[(\d+(?:\.\d+)?)\]/)?.[1] ?? "";

  const rebarMatches = [...ocrText.matchAll(/H\d+\s*@\s*\d+/g)].map((m) =>
    m[0].replace(/\s+/g, "")
  );

  const chairBar = rebarMatches.find((value) => /H\d+@2000/.test(value)) ?? "";

  const h29Bars = rebarMatches.filter((value) => /H29@200/.test(value));

  return {
    thickness,
    chairBar,
    topSubBar: h29Bars[0] ?? "",
    bottomSubBar: h29Bars[1] ?? "",
    topMainBar: h29Bars[2] ?? "",
    bottomMainBar: h29Bars[3] ?? "",
    reinforcement: []
  };
}
