export type RebarStatus =
  | "자동추출"
  | "확인필요"
  | "수동수정"
  | "확인완료"
  | "제외";

export type PartName =
  | "기초"
  | "기둥"
  | "보"
  | "슬라브"
  | "옹벽"
  | "계단"
  | "미분류";

export type PageHeader = {
  projectName: string;
  dongName: string;
  partName: PartName | string;
  pageNumber: number;
};

export type CardBox = {
  cardIndex: number;
  x: number;
  y: number;
  width: number;
  height: number;
};

export type RebarProject = {
  projectName: string;
  sourceFile: string;
  pageCount: number;
  buildings: RebarBuilding[];
};

export type RebarBuilding = {
  dongName: string;
  parts: RebarPart[];
};

export type RebarPart = {
  partName: PartName | string;
  items: RebarItem[];
};

export type RebarItem = {
  page: number;
  cardIndex: number;
  partName: PartName | string;
  dongName: string;
  name: string;
  symbol: string;
  summary?: string;
  cardImageUrl?: string;
  status: RebarStatus;
  data?:
    | FoundationData
    | ColumnData
    | BeamData
    | SlabData
    | WallData
    | StairData;
};

export type FoundationData = {
  thickness: string;
  chairBar: string;
  topSubBar: string;
  bottomSubBar: string;
  topMainBar: string;
  bottomMainBar: string;
  reinforcement: string[];
};

export type ColumnData = {
  width: string;
  height: string;
  mainBar: {
    diameter: string;
    count: string;
  };
  subMainBar: {
    diameter: string;
    count: string;
  };
  tieBar: {
    topRatio: string;
    middleRatio: string;
    bottomRatio: string;
    top: string;
    middle: string;
    bottom: string;
  };
  subTieBar: {
    shape: string;
    xCount: string;
    yCount: string;
    totalCount: string;
  };
};

export type BeamData = {
  rows: BeamRow[];
};

export type BeamRow = {
  zone: "내단부" | "중앙부" | "외단부";
  topBar: string;
  bottomBar: string;
  stirrup: string;
  subStirrupVertical: string;
  subStirrupHorizontal: string;
  subBar1: string;
  subBar2: string;
};

export type SlabData = {
  thickness: string;
  isDeck: boolean;
  topMainBar: string;
  topSubBar: string;
  bottomMainBar: string;
  bottomSubBar: string;
};

export type WallData = {
  thickness: string;
  verticalOuter: string;
  verticalInner: string;
  horizontalOuter: string;
  horizontalInner: string;
  topCutBar: string;
  bottomCutBar: string;
  widthFixBar1: string;
  widthFixBar2: string;
  ucBar: string;
  verticalReinforcement: string;
  horizontalReinforcement: string;
};

export type StairData = {
  thickness: string;
  rows: StairRow[];
};

export type StairRow = {
  area: "참부" | "계단부" | "보강근";
  barType: "주근" | "부근" | "보강근";
  position: string;
  rebar: string;
};
