import type { RebarProject } from "../types/rebar";

type Props = {
  onParsed: (project: RebarProject) => void;
};

export function PdfUploader({ onParsed }: Props) {
  async function handleFileChange(event: React.ChangeEvent<HTMLInputElement>) {
    const file = event.target.files?.[0];
    if (!file) return;

    // TODO:
    // 1. pdfjs-dist로 페이지 이미지 변환
    // 2. extractHeader 실행
    // 3. detectCards 실행
    // 4. part별 parser 실행
    // 5. RebarProject 생성 후 onParsed 호출

    const emptyProject: RebarProject = {
      projectName: "",
      sourceFile: file.name,
      pageCount: 0,
      buildings: []
    };

    onParsed(emptyProject);
  }

  return (
    <div className="pdf-uploader">
      <input type="file" accept="application/pdf" onChange={handleFileChange} />
      <button type="button">분석 실행</button>
    </div>
  );
}
